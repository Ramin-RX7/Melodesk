{
  "name": "melodesk",
  "version": "0.2.0",
  "description": "Music Player App",
  "main": "dist/main.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc && copyfiles -u 1 \"assets/**/*\" dist/assets && vite build",
    "start": "npm run compile && electron .",
    "dev": "nodemon --watch src --watch assets --ext ts,tsx,css,html,png,ico --exec \"npm start\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check",
    "pack": "npm run compile && electron-builder --dir",
    "build": "npm run compile && electron-builder",
    "build:win": "npm run compile && electron-builder --win",
    "build:mac": "npm run compile && electron-builder --mac",
    "build:linux": "npm run compile && electron-builder --linux"
  },
  "keywords": [],
  "author": "RaminRX7",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "copyfiles": "^2.4.1",
    "electron": "^29.4.6",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9"
  },
  "build": {
    "appId": "com.raminrx7.melodesk",
    "productName": "MeloDesk",
    "executableName": "melodesk",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "mac": {
      "icon": "assets/icon.png"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  }
}
