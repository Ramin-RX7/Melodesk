{
  // Type-checks the tests (and the source they import). Never emits: tests are run by Vitest,
  // not compiled into dist/.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": ["../src", "./**/*", "../vitest.config.mts"],
  "exclude": ["./fixtures/generated"]
}
